@page
@using Eshop_RazorPage.Models.User
@model Eshop_RazorPage.Pages.Admin.UserRoles.IndexModel
@{
    ViewData["title"] = "مدیریت نقش کاربران";
    ViewData["selected"] = "User_Role";
    var count = 0;
    var roles = new List<string>();
}
<a asp-page="Add" class="btn btn-success mb-2">افزودن اسلایدر</a>
<div class="table-responsive card card-body p-0">
    <table class="table table-bordered mb-0">
        <thead>
            <tr>
                <th>#</th>
                <th>UserName</th>
                <th>RoleTitle</th>
                <th>CreationData</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.users)
            {
                <tr>
                    <td>@count+=1</td>
                    <td>@item.userName</td>
                    <td>

                    </td>
                    <td>
                        <a asp-page="Edit" class="btn btn-primary btn-sm" asp-route-id="@item.Id">ویرایش</a>

                        <delete-item url="@Url.Page("Index", "DeleteSlider", new { sliderId = item.Id })">
                            حذف
                        </delete-item>
                    </td>
                </tr>
            }
            @if (Model.users.Any() == false)
            {
                <tr>
                    <td colspan="4" class="text-center">موردی برای نمایش وجود ندارد</td>
                </tr>
            }
        </tbody>
    </table>
</div>