@using Eshop_RazorPage.Models.Banner
@model EditBannerCommand
@{
    ViewData["selected"] = "Banners";
}
<form method="post" data-ajax="true" asp-page="Index" asp-page-handler="EditBanner" enctype="multipart/form-data">
    @Html.HiddenFor(b=>b.Id)
    <div class="row">
        <div class="col-md-6">
            @Html.EditorFor(f => f.Link)
        </div>
        <div class="col-md-6">
            @Html.EditorFor(f => f.Position)
        </div>
        <div class="col-md-12">
            @Html.EditorFor(f => f.ImageFile)
        </div>
    </div>
    <button type="submit" class="btn btn-primary">
        ذخیره تغییرات
    </button>
</form>
