@using Eshop_RazorPage.Infrastructure
@using Eshop_RazorPage.Services.User
@inject IUserServices _service;
@{
    var user = await _service.GetCurrentUser();
}
<div class="col-lg-3 col-md-4 mb-md-0 mb-3 sticky-sidebar">
    <div class="sidebar-widget">
        <div class="banner mb-3">
            <a href="#">
                <img src="../assets/images/banner/banner-profile-sidebar.jpg"
                     class="box-shaow-unset has-border" alt="...">
            </a>
        </div>
        <div class="profile-sidebar shadow-around">
            <div class="d-flex align-items-center">
                <div class="profile-avatar">
                    <img src="@SiteSettings.ServerPath/Images/Users/avatar/@user?.avatarName" alt="avatar">
                </div>
                <div class="profile-info">
                    <div class="d-block">
                        <h6><strong>@user.fullName</strong></h6>
                    </div>
                    <div class="d-block">
                        <strong class="text-muted">@user.phoneNumber</strong>
                    </div>
                </div>
            </div>
            <div class="user-options">
                <ul>
                    <li>
                        <a href="#">
                            <span>کیف پول</span>
                            <span>
                                2,500,000 <span class="text-info font-weight-bold">تومان</span>
                            </span>
                        </a>
                    </li>
                    <li>
                        <a href="#">
                            <span>همتا کلاب</span>
                            <span>0 <span class="text-info font-weight-bold">امتیاز</span></span>
                        </a>
                    </li>
                </ul>
            </div>
            <div class="user-menu">
                <ul>
                    <li>
                        <a href="../Profile/Index">
                            <i class="fas fa-home"></i>
                            داشبورد
                        </a>
                    </li>
                    <li>
                        <a href="#">
                            <i class="far fa-clipboard-list-check"></i>
                            سفارش های من
                        </a>
                    </li>
                    <li>
                        <a href="#">
                            <i class="far fa-heart"></i>
                            لیست علاقمندی
                        </a>
                    </li>
                    <li>
                        <a href="#">
                            <i class="far fa-comment-alt-lines"></i>
                            نظرات
                        </a>
                    </li>
                    <li>
                        <a href="../Profile/Address">
                            <i class="far fa-map-marked"></i>
                            نشانی ها
                        </a>
                    </li>
                    <li>
                        <a href="#">
                            <i class="far fa-envelope"></i>
                            پیغام ها
                        </a>
                    </li>
                    <li>
                        <a href="#">
                            <i class="far fa-clock"></i>
                            بازدیدهای اخیر
                        </a>
                    </li>
                    <li>
                        <a href="../Profile/ChangePassword">
                            <i class="far fa-lock"></i>
                           تغیر کلمه عبور
                        </a>
                    </li>
                    <li>
                        <a href="../Profile/Edit">
                            <i class="far fa-user-cog"></i>
                            اطلاعات حساب
                        </a>
                    </li>
                    <li>
                        <a href="../auth/logout">
                            <i class="far fa-sign-in-alt"></i>
                            خروج
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>