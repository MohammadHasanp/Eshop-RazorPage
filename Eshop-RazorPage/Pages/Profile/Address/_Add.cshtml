@using Eshop_RazorPage.ViewModel
@using Eshop_RazorPage.ViewModel.Users
@model AddUserAddressViewModel
<div class="modal-body">
    <form data-ajax="true" method="post" asp-page="Index" asp-page-handler="AddAddress">
        <div class="row">
            <div class="col-lg-6 mb-3">
                <div class="text-sm text-muted mb-1"></div>
                <div class="text-dark font-weight-bold">
                    <div class="form-element-row mb-0">
                        @Html.EditorFor(a => a.PostalAddress)
                    </div>
                </div>
            </div>
            <div class="col-lg-6 mb-3">
                <div class="text-sm text-muted mb-1"></div>
                <div class="text-dark font-weight-bold">
                    <div class="form-element-row mb-0">
                        @Html.EditorFor(a => a.PostalCode)
                    </div>
                </div>
            </div>
            <div class="col-lg-6 mb-3">
                <div class="text-sm text-muted mb-1"></div>
                <div class="text-dark font-weight-bold">
                    <div class="form-element-row mb-0">
                        @Html.EditorFor(a => a.Family)
                    </div>
                </div>
            </div>
            <div class="col-lg-6 mb-3">
                <div class="text-sm text-muted mb-1"></div>
                <div class="text-dark font-weight-bold">
                    <div class="form-element-row mb-0">
                        @Html.EditorFor(a => a.Name)
                    </div>
                </div>
            </div>
            <div class="col-lg-6 mb-3">
                <div class="text-sm text-muted mb-1"></div>
                <div class="text-dark font-weight-bold">
                    <div class="form-element-row mb-0">
                        @Html.EditorFor(a => a.PhoneNumber)
                    </div>
                </div>
            </div>
            <div class="col-lg-6 mb-3">
                <div class="text-sm text-muted mb-1"></div>
                <div class="text-dark font-weight-bold">
                    <div class="form-element-row mb-0">
                        @Html.EditorFor(a => a.NationalCode)
                    </div>
                </div>
            </div>
            <div class="col-lg-6 mb-3">
                <div class="text-sm text-muted mb-1"></div>
                <div class="text-dark font-weight-bold">
                    <div class="form-element-row mb-0">
                        @Html.EditorFor(a => a.Shire)
                    </div>
                </div>
            </div>
            <div class="col-lg-6 mb-3">
                <div class="text-sm text-muted mb-1"></div>
                <div class="text-dark font-weight-bold">
                    <div class="form-element-row mb-0">
                        @Html.EditorFor(a => a.City)
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-footer">
            <button type="submit" class="btn btn-primary">
                ذخیره تغییرات <i class="fad fa-money-check-edit"></i>
            </button>
        </div>
    </form>
</div>
