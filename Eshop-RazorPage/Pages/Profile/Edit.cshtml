@page
@model Eshop_RazorPage.Pages.Profile.EditModel
@{
}
<div class="row mb-5">
    <partial name="Profile/_ProfileSideBar" />
    <div class="col-lg-9 col-md-12">
        <div class="row mb-4">
            <div class="col-12">
                <div class="section-title mb-2">
                    اطلاعات شخصی
                </div>
                <section class="shadow-around p-4">
                    <form method="post" enctype="multipart/form-data">
                        <div class="row">
                            <div class="col-lg-6 mb-6">
                                <div class="text-sm text-muted mb-3"></div>
                                <div class="text-dark font-weight-bold">
                                    <div class="form-element-row mb-0">
                                        @Html.EditorFor(p => p.UserName)
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-6 mb-6">
                                <div class="text-sm text-muted mb-3"></div>
                                <div class="text-dark font-weight-bold">
                                    <div class="form-element-row mb-0">
                                        @Html.EditorFor(p => p.FullName)

                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-6 mb-6">
                                <div class="text-sm text-muted mb-3"></div>
                                <div class="text-dark font-weight-bold">
                                    <div class="form-element-row mb-10">
                                        @Html.EditorFor(p => p.PhoneNumber)

                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-6 mb-6">
                                <div class="text-sm text-muted mb-3"></div>
                                <div class="text-dark font-weight-bold">
                                    <div class="form-element-row mb-10">
                                        @Html.EditorFor(p => p.Email)
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-6 mb-6">
                                <div class="text-sm text-muted mb-3"></div>
                                <div class="text-dark font-weight-bold">
                                    <div class="form-element-row mb-10">
                                        @Html.EditorFor(p => p.Gender)

                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-6 mb-6">
                                <div class="text-sm text-muted mb-3"></div>
                                <div class="text-dark font-weight-bold">
                                    <div class="form-element-row mb-10">
                                        @Html.EditorFor(p => p.Avatar)

                                    </div>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="form-element-row text-left">
                                    <button type="submit" class="col-lg-12 btn-element btn-success-element">
                                        <i class="fad fa-user-edit"></i>
                                        ذخیره تغییرات
                                    </button>
                                </div>
                            </div>
                        </div>
                    </form>
                </section>
            </div>
        </div>
    </div>
</div>
